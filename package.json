{
  "name": "invoice-ui",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"client,api\" -c \"cyan.bold,magenta.bold\" \"npm:dev:client\" \"npm:dev:api\"",
    "dev:client": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "node scripts/migrate.mjs",
    "db:restore": "node scripts/restore.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.json *.ts",
    "types": "wrangler types",
    "dry-run": "npm run build && wrangler deploy --dry-run",
    "email:test": "node scripts/test-email.mjs",
    "sync:agents": "node scripts/sync-agent-config.mjs",
    "sync:agents:check": "node scripts/sync-agent-config.mjs --check"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2",
    "@neondatabase/serverless": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "hono": "^4.13.7",
    "lucide-react": "^1.45.0",
    "motion": "^13.2.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "resend": "^6.28.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.92.0"
  }
}
